#!/bin/bash
# Switch the installed Swaytastic look. Copied to ~/.local/bin/switch_theme.
# Usage: switch_theme [pack]
#        switch_theme --list
set -euo pipefail

REPO="${SWAYTASTIC_ROOT:-$HOME/Swaytastic}"
APPLY="$REPO/local/apply-pack.py"
PACKS_DIR="$REPO/local/packs"

usage() {
  echo "usage: switch_theme [pack]" >&2
  echo "       switch_theme --list" >&2
}

if [[ ! -f "$APPLY" ]]; then
  echo "apply-pack.py not found at $APPLY" >&2
  echo "set SWAYTASTIC_ROOT to the repo clone" >&2
  exit 1
fi

list_packs() {
  python3 "$APPLY" --list
}

apply_pack() {
  local pack="$1"
  python3 "$APPLY" "$pack" --live --repo --root "$REPO" --reload
  echo "active pack: $pack"
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

if [[ "${1:-}" == "--list" || "${1:-}" == "-l" ]]; then
  list_packs
  exit 0
fi

if [[ $# -ge 1 ]]; then
  apply_pack "$1"
  exit 0
fi

if [[ ! -t 0 ]]; then
  list_packs
  usage
  exit 0
fi

shopt -s nullglob
PACKS=("$PACKS_DIR"/*.conf)
shopt -u nullglob
if [[ ${#PACKS[@]} -eq 0 ]]; then
  echo "no packs in $PACKS_DIR" >&2
  exit 1
fi

DEFAULT_PACK=""
if [[ -f $REPO/local/active-pack ]]; then
  DEFAULT_PACK=$(tr -d '[:space:]' < "$REPO/local/active-pack")
fi

echo "Theme packs:"
i=1
DEFAULT_I=1
for p in "${PACKS[@]}"; do
  n=$(basename "$p" .conf)
  echo "  $i) $n"
  if [[ $n == "$DEFAULT_PACK" ]]; then
    DEFAULT_I=$i
  fi
  i=$((i + 1))
done
read -r -p "Select pack [$DEFAULT_I=${DEFAULT_PACK:-}]: " choice
choice=${choice:-$DEFAULT_I}
if ! [[ "$choice" =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#PACKS[@]} )); then
  echo "invalid selection" >&2
  exit 1
fi
PACK=$(basename "${PACKS[choice-1]}" .conf)
apply_pack "$PACK"
