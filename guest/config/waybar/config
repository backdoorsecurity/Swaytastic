{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-bottom": 0,
    "spacing": 0,
    "modules-left": ["sway/workspaces"],
    "modules-right": ["clock"],
    "clock": {
        "interval": 30,
        "format": "{:%Y-%m-%d %H:%M}"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "brave",
            "2": "terminal",
            "3": "terminal",
            "4": "terminal",
            "5": "terminal",
            "default": "{name}"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    }
}
