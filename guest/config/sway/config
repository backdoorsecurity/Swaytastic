############################################ [SWAY CONFIG] ###########################################

############################################# [VARIABLES] ##########################################

include $HOME/.config/sway/variables
include $HOME/.config/sway/color_schemes/sway.conf

###############################################################################################


######################################## [KEYBINDINGS] ########################################
	
	bindsym $mod+a workspace $ws_brave
	bindsym $mod+s workspace $ws_term
	bindsym $mod+d workspace $ws_term2
	bindsym $mod+f workspace $ws_term3
	bindsym $mod+g workspace $ws_term4
	
	bindsym $mod+j focus left
	bindsym $mod+Down focus down
	bindsym $mod+Up focus up
	bindsym $mod+k focus right
	
	bindsym $mod+Shift+r reload
	
	bindsym $mod+x kill
        bindsym $mod+q workspace $ws_brave, exec --no-startup-id $HOME/.config/sway/scripts/brave
        bindsym $mod+w exec --no-startup-id $envexec foot
        bindsym $mod+e exec --no-startup-id $envexec foot
        bindsym $mod+r exec --no-startup-id $envexec foot
        bindsym $mod+t exec --no-startup-id $envexec foot
	bindsym $mod+i fullscreen
	bindsym $mod+Escape exec --no-startup-id poweroff
	bindsym $mod+Shift+d exec $envexec pcmanfm-qt --desktop-pref --profile=sway

#	bindsym $mod+0 layout stacking
#	bindsym $mod+9 layout tabbed
#	bindsym $mod+8 layout toggle split
#	mode "resize" {
#	up/down height left/right width
#	bindsym Left resize shrink width 10px
#	You can "split" the current object of your focus with
#	$mod+b or $mod+v, for horizontal and vertical splits
#	respectively.
#	bindsym $mod+0 splith
#	bindsym $mod+9 splitv
#	Toggle the current focus between tiling and floating mode
#	bindsym $mod+8 floating toggle

	bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
	bindsym --locked XF86AudioLowerVolume exec pactl set-sink-volume \@DEFAULT_SINK@ -5%
	bindsym --locked XF86AudioRaiseVolume exec pactl set-sink-volume \@DEFAULT_SINK@ +5%
	bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
	bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
	bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
	bindsym Print exec grim

############################################################################################################

######################################## [INPUTS/OUTPUTS] ##################################################

#	[DISPLAY]

	output * resolution 1280x800 scale 1

#	[TOUCHPAD]
	input * { 
	dwt enabled
	tap enable
	accel_profile adaptive
        pointer_accel 1 drag enabled
        #middle_emulation enabled
}
#	[KEYBOARD]
        input * { 
	repeat_delay 250
	repeat_rate 60
}

#########################################################################################################

########################################## [STYLING] ####################################################

# [Status Bar] swaybar cannot outline the whole bar; waybar CSS can.
bar {
    position top
    swaybar_command waybar
}

# pin apps onto the static workspaces (terminals stay unassigned)
assign [app_id="brave-origin-nightly"] $ws_brave
assign [app_id="brave-browser"] $ws_brave
assign [class="Brave-browser"] $ws_brave

# [WINDOW MANAGEMENT]
#                       border| background|text|   indicator|child_border
client.focused          $accent $bg_window $fg $indicator $child_border
client.focused_inactive $accent $bg_window $fg $indicator $child_border
client.unfocused        $accent $bg_window $fg $indicator $child_border
client.urgent           $accent $bg_window $fg $indicator $child_border
client.placeholder      $accent $bg_window $fg $indicator $child_border

# [WINDOW SIZING]
#
titlebar_border_thickness 0
default_border pixel 0
hide_edge_borders none
gaps left 0
gaps right 0
gaps bottom 0
gaps top 0
for_window [app_id="foot"] border pixel 0
#default_floating_border pixel 8 8
#titlebar_padding 3 3
#gaps inner 2
#title_align center

exec_always brightnessctl set 70%
exec_always pgrep -x wlsunset || wlsunset -t 3200
# desktop icons (layer-shell). exec, not exec_always, so reload does not duplicate.
exec $envexec pcmanfm-qt --desktop --profile=sway
exec_always $HOME/.config/sway/scripts/apply-gtk-interface.sh
# push toolkit env to dbus/portals (Brave/GTK). values come from $HOME/.config/sway/env
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME QT_QPA_PLATFORM QT_STYLE_OVERRIDE GDK_BACKEND GTK_THEME XCURSOR_THEME XCURSOR_SIZE 2>/dev/null || true
font monospace 16
include /etc/sway/config-vars.d/*
include /etc/sway/config.d/*
