# Sway compositor variables. Included from $HOME/.config/sway/config.
# Session toolkit env (GTK/Qt/cursor for apps) is $HOME/.config/sway/env.

set $mod Mod1
set $term foot
#set $menu wmenu-run
set $menu wofi --show drun
set $envexec $HOME/.config/sway/env-exec

# numbered so waybar can sort left-to-right; labels are in waybar
set $ws_brave        1
set $ws_term         2
set $ws_term2        3
set $ws_term3        4
set $ws_virt         5

set $xcursor_theme oxy-red-argentina
set $xcursor_size 50
seat * xcursor_theme $xcursor_theme $xcursor_size
