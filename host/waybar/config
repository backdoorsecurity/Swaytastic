{
    "layer": "top",
    "position": "top",
    "height": 40,
    "margin-bottom": 0,
    "spacing": 0,
    "modules-left": ["sway/workspaces"],
    "modules-right": ["clock", "battery"],
    "clock": {
        "interval": 30,
        "format": "{:%Y-%m-%d %H:%M}"
    },
    "battery": {
        "interval": 5,
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {icon} {capacity}%",
        "format-plugged": "⚡ {icon} {capacity}%",
        "format-full": "⚡ {icon} {capacity}%",
        "format-not-charging": "{icon} {capacity}%",
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip-format": "{capacity}%  {time}"
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "1": "brave",
            "2": "terminal",
            "3": "terminal",
            "4": "terminal",
            "5": "virt-manager",
            "default": "{name}"
        },
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": []
        }
    }
}
